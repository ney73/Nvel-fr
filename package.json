{
  "name": "synthetiq-manga-sources",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "finalize": "node scripts/finalize-hashes.mjs",
    "test": "node --test modules/novelfrance/test.mjs modules/noveldelaube/test.mjs modules/novelneko-wn/test.mjs modules/novelneko-ln/test.mjs modules/anime-sama/test.mjs tests/documentation.test.mjs && node scripts/source-contract-audit.mjs && node scripts/validate.mjs && node scripts/verify-repository.mjs",
    "test:contracts": "node --test tests/chapter-ownership.test.mjs && node scripts/source-contract-audit.mjs",
    "test:live": "RUN_LIVE_TESTS=1 node scripts/live-smoke.mjs",
    "test:novel-sources:live": "node scripts/live-novel-sources-proof.mjs",
    "test:novel-sources:new:live": "node scripts/live-new-novel-sources.mjs && node modules/novelneko-ln/live-smoke.mjs",
    "test:mangabuddy:live": "node scripts/live-mangabuddy-proof.mjs --live",
    "test:atsu:live": "RUN_LIVE_TESTS=1 node scripts/live-atsu-proof.mjs",
    "test:asura:live": "node scripts/live-asura-proof.mjs --live --with-discovery",
    "test:poseidon:live": "RUN_LIVE_TESTS=1 node scripts/live-poseidon-proof.mjs",
    "test:module": "node scripts/module-tester.mjs",
    "test:module:fixtures": "node scripts/module-tester.mjs --fixtures",
    "test:module:report": "node scripts/module-tester.mjs --report",
    "test:module:report:fixtures": "node scripts/module-tester.mjs --fixtures --report",
    "certify:flagships": "node scripts/source-certifier.mjs --mode all",
    "certify:flagships:fixtures": "node scripts/source-certifier.mjs --mode fixtures",
    "certify:flagships:live": "node scripts/source-certifier.mjs --mode live",
    "certify:flagships:ios": "node scripts/source-certifier.mjs --mode ios",
    "mcp:certifier": "node scripts/module-certifier-mcp.mjs",
    "report:module": "node scripts/module-tester.mjs --report",
    "verify": "node scripts/validate.mjs && node scripts/verify-repository.mjs"
  }
}
